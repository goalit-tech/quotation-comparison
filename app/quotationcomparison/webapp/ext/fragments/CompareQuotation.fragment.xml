<core:FragmentDefinition
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:uiTable="sap.ui.table"
    xmlns:macros="sap.fe.macros"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="myCompareQuotationDialog"
        title="Create Quotation"
    >
        <!-- <macros:Form
            metaPath="/RFQs/QuotationComparison/@com.sap.vocabularies.UI.v1.FieldGroup#QuotationComparisonDetails"
            id="_IDGenddQuotationCreateForm"
            title="Sample Form"
        /> -->
        <f:SimpleForm
            id="_idGenCompareQuotationForm"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4"
            labelSpanL="4"
            labelSpanM="4"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="0"
            emptySpanL="0"
            emptySpanM="0"
            emptySpanS="0"
            columnsXL="3"
            columnsL="2"
            columnsM="2"
            singleContainerFullSize="false"
        >
            <f:content>
                <core:Title id="_IDGenCompareQuotationFormTitle1" text="" />
                <Label
                    id="_IDGenCompareQuotationFormLabel6"
                    text="RFQ"
                />
                <Input
                    id="_IDGenCompareQuotationFormInput"
                    value="{oLocalModel>/compareQuotationData/RFQ}"
                    editable="false"
                />
                <Label
                    id="_IDGenCompareQuotationFormLabel7"
                    text="company Name"
                />
                <Input
                    id="_IDGenCompareQuotationFormInput1"
                    value="{oLocalModel>/compareQuotationData/CompanyName}"
                />
                <Label
                    id="_IDGenCompareQuotationFormLabel8"
                    text="comparativeStatementTitle"
                />
                <Input
                    id="_IDGenCompareQuotationFormInput2"
                    value="{oLocalModel>/compareQuotationData/ComparativeStatementTitle}"
                />

                <Label
                    id="_IDGenCompareQuotationFormLabel9"
                    text="requestorName"
                />
                <Input
                    id="_IDGenCompareQuotationFormInput3"
                    value="{oLocalModel>/compareQuotationData/RequestorName}"
                />
                <Label
                    id="_IDGenCompareQuotationFormLabel10"
                    text="accountAssignment"
                />
                <Input
                    id="_IDGenCompareQuotationFormInput4"
                    value="{oLocalModel>/compareQuotationData/AccountAssignment}"
                />
                <core:Title id="_IDGenCompareQuotationFormTitle2" text="" />
                <Label
                    id="_IDGenCompareQuotationFormLabel11"
                    text="requisitionNumber"
                />
                <Input
                    id="_IDGenCompareQuotationFormInput5"
                    value="{oLocalModel>/compareQuotationData/RequisitionNumber}"
                />

                <Label
                    id="_IDGenCompareQuotationFormLabel12"
                    text="requisitionDate"
                />
                <DateTimePicker
                    id="_IDGenCompareQuotationFormDateTimePicker"
                    value="{oLocalModel>/compareQuotationData/RequisitionDate}"
                />
                <Label
                    id="_IDGenCompareQuotationFormLabel13"
                    text="purpose"
                />
                <Input
                    id="_IDGenCompareQuotationFormDateTimePicker1"
                    value="{oLocalModel>/compareQuotationData/Purpose}"
                />
                <Label
                    id="_IDGenCompareQuotationFormLabel14"
                    text="comparisonDate"
                />
                <DateTimePicker
                    id="_IDGenCompareQuotationFormDateTimePicker2"
                    value="{oLocalModel>/compareQuotationData/ComparisonDate}"
                />
            </f:content>
        </f:SimpleForm>

        <VBox id="_IDGenCompareQuotationVBox">
            <uiTable:Table
                id="_IDGenCompareQuotationUITable"
                selectionMode="MultiToggle"
                rows="{oLocalModel>/compareQuotationItemData}"
                enableCellFilter="true"
                filter=".filterPrice"
                ariaLabelledBy="title"
            >
               
            </uiTable:Table>
        </VBox>
        <buttons>
            <Button
                id="_IDGenCompareQuotationCancelButton"
                text="Cancel"
                press=".onCompareQuotationCancelPress"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
