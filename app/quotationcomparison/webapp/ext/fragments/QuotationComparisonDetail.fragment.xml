<core:FragmentDefinition
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:uiTable="sap.ui.table"
    xmlns:macros="sap.fe.macros"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:core="sap.ui.core"
>
    <Panel id="_IDGenPanel" expandable="false" expanded="true">
    <f:SimpleForm
            id="_idGenCompareQuotationDetailDetailForm"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4"
            labelSpanL="4"
            labelSpanM="4"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="0"
            emptySpanL="0"
            emptySpanM="0"
            emptySpanS="0"
            columnsXL="3"
            columnsL="2"
            columnsM="2"
            singleContainerFullSize="false"
        >
            <f:content>
                <core:Title id="_idGenCompareQuotationDetailFormTitle1" text="" />
                <Label
                    id="_idGenCompareQuotationDetailFormLabel6"
                    text="RFQ"
                />
                <Input
                    id="_idGenCompareQuotationDetailFormInput"
                    value="{oLocalModel>/compareQuotationData/requisitionNumber}"
                    editable="false"
                />
                <Label
                    id="_idGenCompareQuotationDetailFormLabel7"
                    text="company Name"
                />
                <Input
                    id="_idGenCompareQuotationDetailFormInput1"
                    value="{oLocalModel>/compareQuotationData/companyName}"
                    editable="{oLocalModel>/compareQuotationIsEditable}"
                />
                <Label
                    id="_idGenCompareQuotationDetailFormLabel8"
                    text="comparativeStatementTitle"
                />
                <Input
                    id="_idGenCompareQuotationDetailFormInput2"
                    value="{oLocalModel>/compareQuotationData/comparativeStatementTitle}"
                    editable="{oLocalModel>/compareQuotationIsEditable}"
                />

                <Label
                    id="_idGenCompareQuotationDetailFormLabel9"
                    text="requestorName"
                />
                <Input
                    id="_idGenCompareQuotationDetailFormInput3"
                    value="{oLocalModel>/compareQuotationData/requestorName}"
                    editable="{oLocalModel>/compareQuotationIsEditable}"
                />
                <Label
                    id="_idGenCompareQuotationDetailFormLabel10"
                    text="accountAssignment"
                />
                <Input
                    id="_idGenCompareQuotationDetailFormInput4"
                    value="{oLocalModel>/compareQuotationData/accountAssignment}"
                    editable="{oLocalModel>/compareQuotationIsEditable}"
                />
                <core:Title id="_idGenCompareQuotationDetailFormTitle2" text="" />
                <Label
                    id="_idGenCompareQuotationDetailFormLabel11"
                    text="requisitionNumber"
                />
                <Input
                    id="_idGenCompareQuotationDetailFormInput5"
                    value="{oLocalModel>/compareQuotationData/requisitionNumber}"
                    editable="{oLocalModel>/compareQuotationIsEditable}"
                />

                <Label
                    id="_idGenCompareQuotationDetailFormLabel12"
                    text="requisitionDate"
                />
                <DateTimePicker
                    id="_idGenCompareQuotationDetailFormDateTimePicker"
                    value="{oLocalModel>/compareQuotationData/requisitionDate}"
                    editable="{oLocalModel>/compareQuotationIsEditable}"
                />
                <Label
                    id="_idGenCompareQuotationDetailFormLabel13"
                    text="purpose"
                />
                <Input
                    id="_idGenCompareQuotationDetailFormDateTimePicker1"
                    value="{oLocalModel>/compareQuotationData/purpose}"
                    editable="{oLocalModel>/compareQuotationIsEditable}"
                />
                <Label
                    id="_idGenCompareQuotationDetailFormLabel14"
                    text="comparisonDate"
                />
                <DateTimePicker
                    id="_idGenCompareQuotationDetailFormDateTimePicker2"
                    value="{oLocalModel>/compareQuotationData/comparisonDate}"
                    editable="{oLocalModel>/compareQuotationIsEditable}"
                />
            </f:content>
        </f:SimpleForm>
        <VBox id="_IDGenCompareQuotationDetailVBox">
            <uiTable:Table
                id="_IDGenCompareQuotationDetailUITable"
                rows="{oLocalModel>/compareQuotationItemData}"
                enableCellFilter="true"
                showNoData="true"
                selectionMode="None"
            >
               
            </uiTable:Table>
        </VBox>
    </Panel>
</core:FragmentDefinition>
