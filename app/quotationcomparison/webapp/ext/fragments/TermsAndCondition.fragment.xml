 <core:FragmentDefinition
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:uiTable="sap.ui.table"
    xmlns:macros="sap.fe.macros"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:core="sap.ui.core"
>
 
<uiTable:Table
                id="_IDGenTermsAndConditionsUITable"
                selectionMode="MultiToggle"
                rows="{oLocalModel>/SupplierQuotationItems}"
                enableCellFilter="true"
                filter=".filterPrice"
                ariaLabelledBy="title"
            >
                <uiTable:extension>
                    <OverflowToolbar
                        id="_IDGenTermsAndConditionsOverflowToolbar1"
                        style="Clear"
                    >
                        <Title
                            id="_IDGenTermsAndConditionsToolbarTitle1"
                            text="Supplier Quotation Items"
                        />
                        <ToolbarSpacer id="_IDGenTermsAndConditionsToolbarSpacer1" />
                        <ToolbarSeparator id="_IDGenTermsAndConditionsToolbarSeparator" />
                         <Button id="_IDGenTermsAndConditionsAddButton" text='Add' press="onAddTerm"/>
                        <Button id="_IDGenTermsAndConditionsLoadButton" text='Load Standard Terms' press="onLoadStandardTerms"/>
                    </OverflowToolbar>
                </uiTable:extension>
                <uiTable:columns>
                    <uiTable:Column
                        id="_IDGenTermsAndConditionsColumn1"
                        width="6rem"
                        sortProperty="Group"
                        filterProperty="Group"
                    >
                        <Label
                            id="_IDGenTermsAndConditionsLabel1"
                            text="Supplier Quotation Item"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenTermsAndConditionsText1"
                                text="{oLocalModel>SupplierQuotationItem}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenTermsAndConditionsColumn2"
                        width="15rem"
                        sortProperty="Material"
                        filterProperty="Material"
                    >
                        <Label
                            id="_IDGenTermsAndConditionsLabel2"
                            text="Material"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenTermsAndConditionsText2"
                                text="{oLocalModel>Material}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenTermsAndConditionsColumn3"
                        width="8rem"
                        sortProperty="SupplierMaterialNumber"
                        filterProperty="SupplierMaterialNumber"
                    >
                        <Label
                            id="_IDGenTermsAndConditionsLabel3"
                            text="Supplier Material Number"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenTermsAndConditionsText3"
                                text="{oLocalModel>SupplierMaterialNumber}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenTermsAndConditionsColumn4"
                        width="6rem"
                        sortProperty="MaterialGroup"
                        filterProperty="MaterialGroup"
                    >
                        <Label
                            id="_IDGenTermsAndConditionsLabel4"
                            text="MaterialGroup"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenTermsAndConditionsText4"
                                text="{oLocalModel>MaterialGroup}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenTermsAndConditionsColumn5"
                        width="12rem"
                        sortProperty="ScheduleLineOrderQuantity"
                        filterProperty="ScheduleLineOrderQuantity"
                    >
                        <Label
                            id="_IDGenTermsAndConditionsLabel5"
                            text="ScheduleLineOrderQuantity"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenTermsAndConditionsText5"
                                text="{oLocalModel>ScheduleLineOrderQuantity}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                </uiTable:columns>
            </uiTable:Table>























 
 <Panel id="_IDGenPanel5"
                headerText="Terms &amp; Conditions"
                backgroundDesign="Solid">

                <headerToolbar>
                    <OverflowToolbar id="_IDGenTermsandconditionOverflowToolbar1">
                        <Title id="_IDGenQuotationTitle2" text="Terms &amp; Conditions"/>
                        <ToolbarSpacer id="_IDGenToolbarSpacer1"/>
                        <!-- <Select id="termsGroupFilter"
                            selectedKey="ALL"
                            change="onTermsGroupFilter">
                            <core:Item id="_IDGenItem1" key="ALL"        text="All Terms"/>
                            <core:Item id="_IDGenItem2" key="REGULAR"    text="Regular Terms"/>
                            <core:Item id="_IDGenItem3" key="SPECIAL"    text="Special Terms"/>
                            <core:Item id="_IDGenItem4" key="ADDITIONAL" text="Additional Terms"/>
                        </Select> -->
                        <Button id="_IDGenButton7"
                            text="Add Term"
                            icon="sap-icon://add"
                            type="Transparent"
                            press="onAddTerm"/>
                        <Button id="_IDGenButton13"
                            text="Load Standard Terms"
                            icon="sap-icon://download"
                            type="Transparent"
                            press="onLoadStandardTerms"/>
                    </OverflowToolbar>
                </headerToolbar>

                <content>
                    <Table id="termsTable"
                        inset="false"
                        width="100%"
                        fixedLayout="true"
                        growing="true"
                        growingThreshold="20"
                        items="{/TermsRows}"
                        noDataText="No terms added. Click '+ Add Term' or 'Load Standard Terms'.">

                        <columns>
                            <Column id="_IDGenColumn9" width="8rem">
                                <Text id="_IDGenText23a" text="Group"/>
                            </Column>
                            <Column id="_IDGenColumn9b" width="22rem" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Block">
                                <Text id="_IDGenText23" text="Select Term"/>
                            </Column>
                            <Column id="_IDGenColumn10" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Block">
                                <Text id="_IDGenText24" text="Vendor 1"/>
                            </Column>
                            <Column id="_IDGenColumn11" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Block">
                                <Text id="_IDGenText25" text="Vendor 2"/>
                            </Column>
                            <Column id="_IDGenColumn18" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Block">
                                <Text id="_IDGenText26" text="Vendor 3"/>
                            </Column>
                            <Column id="_IDGenColumn19" width="6rem" hAlign="Center" demandPopin="true" minScreenWidth="Tablet" popinDisplay="Block">
                                <Text id="_IDGenText27" text="Remove"/>
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem id="_IDGenColumnListItem2">
                                <cells>

                                    <ObjectStatus id="termGroupBadge"
                                        text="{TermGroup}"
                                        state="{TermGroupState}"
                                        inverted="false"/>

                                    <Select id="_IDGenSelect"
                                        selectedKey="{TermCode}"
                                        width="100%"
                                        change="onTermChanged"
                                        items="{/TermsMaster}">
                                        <core:Item id="_IDGenItem" key="{Code}" text="{SeqDisplay}"/>
                                    </Select>

                                    <Input id="_IDGenInput7"
                                        value="{Vendor1Value}"
                                        placeholder="Enter value"/>

                                    <Input id="_IDGenInput8"
                                        value="{Vendor2Value}"
                                        placeholder="Enter value"/>

                                    <Input id="_IDGenInput9"
                                        value="{Vendor3Value}"
                                        placeholder="Enter value"/>

                                    <Button id="_IDGenButton14"
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        tooltip="Remove Term"
                                        press="onRemoveTerm"/>

                                </cells>
                            </ColumnListItem>
                        </items>

                    </Table>
                </content>

            </Panel>
</core:FragmentDefinition>