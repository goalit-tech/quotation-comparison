<core:FragmentDefinition
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:uiTable="sap.ui.table"
    xmlns:macros="sap.fe.macros"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="mySelectDialog"
        title="Create Quotation"
    >
        <!-- <macros:Form
            metaPath="/RFQs/QuotationComparison/@com.sap.vocabularies.UI.v1.FieldGroup#QuotationComparisonDetails"
            id="_IDGenddQuotationCreateForm"
            title="Sample Form"
        /> -->
        <f:SimpleForm
            id="SimpleFormChange480_Trial"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4"
            labelSpanL="4"
            labelSpanM="4"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="0"
            emptySpanL="0"
            emptySpanM="0"
            emptySpanS="0"
            columnsXL="3"
            columnsL="2"
            columnsM="2"
            singleContainerFullSize="false"
        >
            <f:content>
                <core:Title id="_IDGenuotationFormTitle1" text="" />
                <Label
                    id="_IDGenQuotationRequestForQuotationFormLabel"
                    text="Request For Quotation"
                />
                <Input
                    id="_IDGenQuotationRequestForQuotationFormInput"
                    value="{oLocalModel>/CompareQuotation/RequestForQuotation}"
                    editable="false"
                />
                <Label
                    id="_IDGenQuotationCompanyNameFormLabel"
                    text="Company Code"
                />
                <Input
                    id="_IDGenQuotationCompanyNameFormInput"
                    value="{oLocalModel>/CompareQuotation/CompanyName} ({oLocalModel>/CompareQuotation/CompanyCode})"
                    editable="false"
                />
                    <!-- value="{oLocalModel>/CompareQuotation/CompanyCode}" -->
                    <!-- value="{oLocalModel>/CompareQuotation/CompanyName} ({oLocalModel>/CompareQuotation/CompanyCode})" -->
                <Label
                    id="_IDGenQuotationCompativeStatementTitleFormLabel"
                    text="Comparative Statement Title"
                />
                <Input
                    id="_IDGenQuotationCompativeStatementTitleFormInput"
                    value="{oLocalModel>/CompareQuotation/CompativeStatementTitle}"
                />

                <Label
                    id="_IDGenQuotationNameOfRequesterFormLabel"
                    text="Requestor Name"
                />
                <Input
                    id="_IDGenQuotationNameOfRequesterFormInput"
                    value="{oLocalModel>/CompareQuotation/NameOfRequester}"
                />
                <Label
                    id="_IDGenQuotationFormLabel10"
                    text="Account Assignment"
                />
                <Input
                    id="_IDGenQuotationAccountAssignmentFormInput"
                    value="{oLocalModel>/CompareQuotation/AccountAssignment}"
                />
                <core:Title id="_IDGenuotationFormTitle2" text="" />
                <Label
                    id="_IDGenQuotationRequisitionNumberFormLabel"
                    text="Requisition Number"
                />
                <Input
                    id="_IDGenQuotationRequisitionNumberFormInput"
                    value="{oLocalModel>/CompareQuotation/RequisitionNumber}"
                />

                <Label
                    id="_IDGenQuotationRequisitionDateFormLabel"
                    text="Requisition Date"
                />
                <!-- value="{oLocalModel>/CompareQuotation/RequisitionDate}" -->
                <DatePicker
                    id="_IDGenQuotationRequisitionDateFormDateTimePicker"
                    	value="{
						'path':'oLocalModel>/CompareQuotation/RequisitionDate',
						'type':'sap.ui.model.type.Date',
						'formatOptions': {
							'pattern': 'yyyy-MM-dd'
						}
					}"
                />
                <Label
                    id="_IDGenQuotationPurposeFormLabel"
                    text="Purpose"
                />
                <Input
                    id="_IDGenQuotationPurposeFormInput"
                    value="{oLocalModel>/CompareQuotation/Purpose}"
                />
                <Label
                    id="_IDGenQuotationComparisonDateFormLabel"
                    text="Comparison Date"
                />
                <!-- value="{oLocalModel>/CompareQuotation/ComparisonDate}" -->
                <DatePicker
                    id="_IDGenQuotationComparisonDateFormDateTimePicker"
                    value="{
						'path':'oLocalModel>/CompareQuotation/ComparisonDate',
						'type':'sap.ui.model.type.Date',
						'formatOptions': {
							'pattern': 'yyyy-MM-dd'
						}
					}"
                />
            </f:content>
        </f:SimpleForm>

        <VBox id="_IDGenddQCTableSupplierItemsVBox">
        
                <!-- rowSelectionChange=".onCompareQuotationTableRowSelectionChange" -->
                <!-- rows="{path:'oLocalModel>/SupplierQuotation', parameters: {arrayNames:['_SupplierQuotationItem']}}" -->
            <uiTable:Table
                id="_IDGenCompareQuotationSupplierUITable"
                selectionMode="MultiToggle"
                enableSelectAll="false"
                rows="{oLocalModel>/SupplierQuotationItem}"
                enableCellFilter="true"
                filter=".filterPrice"
                ariaLabelledBy="title"
            >
                <uiTable:extension>
                    <OverflowToolbar
                        id="_IDGenQuotationOverflowToolbar1"
                        style="Clear"
                    >
                        <Title
                            id="_IDGenQuotationComparisonTitle"
                            text="Supplier Quotation and Items"
                        />
                        <ToolbarSpacer id="_IDGenQuotationToolbarSpacer1" />
                        <ToolbarSeparator id="_IDGenQuotationToolbarSeparator" />
                        <SearchField
                            id="_IDGenQuotationSearchField"
                            placeholder="Filter"
                            search=".filterGlobally"
                            width="15rem"
                            visible="false"
                        />
                    </OverflowToolbar>
                </uiTable:extension>
                <uiTable:columns>
                <uiTable:Column
                        id="_IDGenSupplierQuotationColumn"
                        width="11rem"
                        sortProperty="SupplierQuotation"
                        filterProperty="SupplierQuotation"
                    >
                        <Label
                            id="_IDGenQuotationSupplierQuotationTableLabel"
                            text="Supplier Quotation" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenQuotationSupplierQuotationTableText"
                                text="{oLocalModel>SupplierQuotation}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                <uiTable:Column
                        id="_IDGenSupplierCodeColumn"
                        width="11rem"
                        sortProperty="SupplierCode"
                        filterProperty="SupplierCode"
                    >
                        <Label
                            id="_IDGenQuotationSupplierCodeTableLabel"
                            text="Supplier Code" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenQuotationSupplierCodeTableText"
                                text="{= ${oLocalModel>SupplierCode} ? ${oLocalModel>SupplierName} + ' (' + ${oLocalModel>SupplierCode} + ')' : '' }"
                                wrapping="true"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenRequestForQuotationItemColumn"
                        width="8rem"
                        sortProperty="RequestForQuotationItem"
                        filterProperty="RequestForQuotationItem"
                    >
                        <Label
                            id="_IDGenRequestForQuotationItemLabel1"
                            text="Item No" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenRequestForQuotationItemText1"
                                text="{oLocalModel>RequestForQuotationItem}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenMaterialTextColumn"
                        width="11rem"
                        sortProperty="Material"
                        filterProperty="Material"
                    >
                        <Label
                            id="_IDGenMaterialTextLabel1"
                            text="Material" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenMaterialText1"
                                text="{oLocalModel>Material}" wrapping="true"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenPurchasingDocumentItemTextColumn"
                        width="11rem"
                        sortProperty="PurchasingDocumentItemText"
                        filterProperty="PurchasingDocumentItemText"
                    >
                        <Label
                            id="_IDGenPurchasingDocumentItemTextLabel1"
                            text="Material" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenPurchasingDocumentItemText1"
                                text="{oLocalModel>PurchasingDocumentItemText}" wrapping="true"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenScheduleLineOrderQuantityColumn"
                        width="6rem"
                        sortProperty="ScheduleLineOrderQuantity"
                        filterProperty="ScheduleLineOrderQuantity"
                    >
                        <Label
                            id="_IDGenScheduleLineOrderQuantityLabel1"
                            text="Quantity" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenScheduleLineOrderQuantityText1"
                                text="{oLocalModel>ScheduleLineOrderQuantity}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenBaseUnitColumn"
                        width="8rem"
                        sortProperty="BaseUnit"
                        filterProperty="BaseUnit"
                    >
                        <Label
                            id="_IDGenBaseUnitLabel2"
                            text="Base Unit of Measure" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenBaseUnitText1"
                                text="{oLocalModel>BaseUnit}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenNetPriceQuantityColumn"
                        width="6rem"
                        sortProperty="NetPriceQuantity"
                        filterProperty="NetPriceQuantity"
                    >
                        <Label
                            id="_IDGenNetPriceQuantityLabel3"
                            text="Unit Price" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenNetPriceQuantityText2"
                                text="{oLocalModel>NetPriceQuantity}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenNetPriceAmountColumn"
                        width="8rem"
                        sortProperty="NetPriceAmount"
                        filterProperty="NetPriceAmount"
                    >
                        <Label
                            id="_IDGenNetPriceAmountLabel3"
                            text="Total value" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenNetPriceAmountText3"
                                text="{oLocalModel>NetPriceAmount}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenNetAmountColumn"
                        width="8rem"
                        sortProperty="NetAmount"
                        filterProperty="NetAmount"
                    >
                        <Label
                            id="_IDGenNetAmountLabel3"
                            text="Total value" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenNetAmountText3"
                                text="{oLocalModel>NetAmount}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenScheduleLineDeliveryDateColumn"
                        width="8rem"
                        sortProperty="ScheduleLineDeliveryDate"
                        filterProperty="ScheduleLineDeliveryDate"
                    >
                        <Label
                            id="_IDGenScheduleLineDeliveryDateLabel4"
                            text="Delivery Date"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenScheduleLineDeliveryDateText4"
                                text="{oLocalModel>ScheduleLineDeliveryDate}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <!-- <uiTable:Column
                        id="_IDGenTaxrateColumn"
                        width="6rem"
                        sortProperty="Taxrate"
                        filterProperty="Taxrate"
                    >
                        <Label
                            id="_IDGenTaxrateLabel5"
                            text="Tax Rate" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenTaxrateText5"
                                text="{oLocalModel>Taxrate}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenDiscountColumn"
                        width="6rem"
                        sortProperty="Discount"
                        filterProperty="Discount"
                    >
                        <Label
                            id="_IDGenDiscountLabel5"
                            text="Discount" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenDiscountText5"
                                text="{oLocalModel>CashDiscount1Percent}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenDFreightChargesColumn"
                        width="6rem"
                        sortProperty="FreightCharges"
                        filterProperty="FreightCharges"
                    >
                        <Label
                            id="_IDGenDFreightChargesLabel5"
                            text="Freight Charges" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenDFreightChargesText5"
                                text="{oLocalModel>FreightCharges}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenInsuranceChargesColumn"
                        width="6rem"
                        sortProperty="InsuranceCharges"
                        filterProperty="InsuranceCharges"
                    >
                        <Label
                            id="_IDGenInsuranceChargesLabel5"
                            text="Insurance Charges" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenInsuranceChargesText5"
                                text="{oLocalModel>InsuranceCharges}"
                            />
                        </uiTable:template>
                    </uiTable:Column> -->
                    <uiTable:Column
                        id="_IDGenYY1_MaterialMake_PDIColumn4"
                        width="6rem"
                        sortProperty="YY1_MaterialMake_PDI"
                        filterProperty="YY1_MaterialMake_PDI"
                    >
                        <Label
                            id="_IDGenYY1_MaterialMake_PDILabel4"
                            text="Make" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenYY1_MaterialMake_PDIText4"
                                text="{oLocalModel>YY1_MaterialMake_PDI}" wrapping="true"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenYY1_Specifications_PDIColumn1"
                        width="6rem"
                        sortProperty="YY1_Specifications_PDI"
                        filterProperty="YY1_Specifications_PDI"
                    >
                        <Label
                            id="_IDGenYY1_Specifications_PDILabel1"
                            text="Specifications" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenYY1_Specifications_PDIText1"
                                text="{oLocalModel>YY1_Specifications_PDI}" wrapping="true"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                </uiTable:columns>
            </uiTable:Table>
        </VBox>
        <buttons>
            <Button
                id="_IDGendCompareQuotationButton"
                text="Add"
                press=".onAddCompareQuotationCreatePress"
            />
            <Button
                id="_IDGendCompareQuotationCancelButton"
                text="Cancel"
                press=".onAddCompareQuotationCancelPress"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
