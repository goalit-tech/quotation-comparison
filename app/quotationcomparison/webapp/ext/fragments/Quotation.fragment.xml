<core:FragmentDefinition
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:uiTable="sap.ui.table"
    xmlns:macros="sap.fe.macros"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="mySelectDialog"
        title="Create Quotation"
    >
        <!-- <macros:Form
            metaPath="/RFQs/QuotationComparison/@com.sap.vocabularies.UI.v1.FieldGroup#QuotationComparisonDetails"
            id="_IDGenddQuotationCreateForm"
            title="Sample Form"
        /> -->
        <f:SimpleForm
            id="SimpleFormChange480_Trial"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4"
            labelSpanL="4"
            labelSpanM="4"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="0"
            emptySpanL="0"
            emptySpanM="0"
            emptySpanS="0"
            columnsXL="3"
            columnsL="2"
            columnsM="2"
            singleContainerFullSize="false"
        >
            <f:content>
                <core:Title id="_IDGenuotationFormTitle1" text="" />
                <Label
                    id="_IDGenQuotationFormLabel6"
                    text="RFQ"
                />
                <Input
                    id="_IDGenQuotationFormInput"
                    value="{oLocalModel>/QuotationCreate/rfq}"
                    editable="false"
                />
                <Label
                    id="_IDGenQuotationFormLabel7"
                    text="Company Name"
                />
                <Input
                    id="_IDGenQuotationFormInput1"
                    value="{oLocalModel>/QuotationCreate/companyName}"
                />
                <Label
                    id="_IDGenQuotationFormLabel8"
                    text="Comparative Statement Title"
                />
                <Input
                    id="_IDGenQuotationFormInput2"
                    value="{oLocalModel>/QuotationCreate/comparativeStatementTitle}"
                />

                <Label
                    id="_IDGenQuotationFormLabel9"
                    text="Requestor Name"
                />
                <Input
                    id="_IDGenQuotationFormInput3"
                    value="{oLocalModel>/QuotationCreate/requestorName}"
                />
                <Label
                    id="_IDGenQuotationFormLabel10"
                    text="Account Assignment"
                />
                <Input
                    id="_IDGenQuotationFormInput4"
                    value="{oLocalModel>/QuotationCreate/accountAssignment}"
                />
                <core:Title id="_IDGenuotationFormTitle2" text="" />
                <Label
                    id="_IDGenQuotationFormLabel11"
                    text="Requisition Number"
                />
                <Input
                    id="_IDGenQuotationFormInput5"
                    value="{oLocalModel>/QuotationCreate/requisitionNumber}"
                />

                <Label
                    id="_IDGenQuotationFormLabel12"
                    text="Requisition Date"
                />
                <DateTimePicker
                    id="_IDGenQuotationFormDateTimePicker"
                    value="{oLocalModel>/QuotationCreate/requisitionDate}"
                />
                <Label
                    id="_IDGenQuotationFormLabel13"
                    text="Purpose"
                />
                <Input
                    id="_IDGenQuotationFormDateTimePicker1"
                    value="{oLocalModel>/QuotationCreate/purpose}"
                />
                <Label
                    id="_IDGenQuotationFormLabel14"
                    text="Comparison Date"
                />
                <DateTimePicker
                    id="_IDGenQuotationFormDateTimePicker2"
                    value="{oLocalModel>/QuotationCreate/comparisonDate}"
                />
            </f:content>
        </f:SimpleForm>

        <VBox id="_IDGenddQCTableSupplierItemsVBox">
            <uiTable:Table
                id="_IDGenddQCTableSupplierItemsUITable"
                selectionMode="MultiToggle"
                rows="{oLocalModel>/SupplierQuotationItems}"
                enableCellFilter="true"
                filter=".filterPrice"
                ariaLabelledBy="title"
            >
                <uiTable:extension>
                    <OverflowToolbar
                        id="_IDGenQuotationOverflowToolbar1"
                        style="Clear"
                    >
                        <Title
                            id="title"
                            text="Supplier Quotation Items"
                        />
                        <ToolbarSpacer id="_IDGenQuotationToolbarSpacer1" />
                        <ToolbarSeparator id="_IDGenQuotationToolbarSeparator" />
                        <SearchField
                            id="_IDGenQuotationSearchField"
                            placeholder="Filter"
                            search=".filterGlobally"
                            width="15rem"
                        />
                    </OverflowToolbar>
                </uiTable:extension>
                <uiTable:columns>
                    <uiTable:Column
                        id="SupplierQuotationItem"
                        width="6rem"
                        sortProperty="SupplierQuotationItem"
                        filterProperty="SupplierQuotationItem"
                    >
                        <Label
                            id="_IDGenLabel1"
                            text="Supplier Quotation Item"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenText"
                                text="{oLocalModel>SupplierQuotationItem}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="Material"
                        width="15rem"
                        sortProperty="Material"
                        filterProperty="Material"
                    >
                        <Label
                            id="_IDGenLabel2"
                            text="Material"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenText1"
                                text="{oLocalModel>Material}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="SupplierMaterialNumber"
                        width="8rem"
                        sortProperty="SupplierMaterialNumber"
                        filterProperty="SupplierMaterialNumber"
                    >
                        <Label
                            id="_IDGenLabel3"
                            text="Supplier Material Number"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenText2"
                                text="{oLocalModel>SupplierMaterialNumber}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="MaterialGroup"
                        width="6rem"
                        sortProperty="MaterialGroup"
                        filterProperty="MaterialGroup"
                    >
                        <Label
                            id="_IDGenLabel4"
                            text="MaterialGroup"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenText3"
                                text="{oLocalModel>MaterialGroup}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="ScheduleLineOrderQuantity"
                        width="12rem"
                        sortProperty="ScheduleLineOrderQuantity"
                        filterProperty="ScheduleLineOrderQuantity"
                    >
                        <Label
                            id="_IDGenLabel5"
                            text="ScheduleLineOrderQuantity"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenText4"
                                text="{oLocalModel>ScheduleLineOrderQuantity}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                </uiTable:columns>
            </uiTable:Table>
        </VBox>
        <buttons>
            <Button
                id="_IDGenddQuotationCreateButton"
                text="Create"
                press=".onAddQuotationCreatePress"
            />
            <Button
                id="_IDGenddQuotationCancelButton"
                text="Cancel"
                press=".onAddQuotationCancelPress"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
