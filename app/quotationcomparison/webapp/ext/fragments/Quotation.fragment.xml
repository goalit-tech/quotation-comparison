<core:FragmentDefinition
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:uiTable="sap.ui.table"
    xmlns:macros="sap.fe.macros"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="mySelectDialog"
        title="Create Quotation"
    >
        <!-- <macros:Form
            metaPath="/RFQs/QuotationComparison/@com.sap.vocabularies.UI.v1.FieldGroup#QuotationComparisonDetails"
            id="_IDGenddQuotationCreateForm"
            title="Sample Form"
        /> -->
        <f:SimpleForm
            id="SimpleFormChange480_Trial"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4"
            labelSpanL="4"
            labelSpanM="4"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="0"
            emptySpanL="0"
            emptySpanM="0"
            emptySpanS="0"
            columnsXL="3"
            columnsL="2"
            columnsM="2"
            singleContainerFullSize="false"
        >
            <f:content>
                <core:Title id="_IDGenuotationFormTitle1" text="" />
                <Label
                    id="_IDGenQuotationFormLabel6"
                    text="RFQ"
                />
                <Input
                    id="_IDGenQuotationFormInput"
                    value="{oLocalModel>/CompareQuotation/rfq}"
                    editable="false"
                />
                <Label
                    id="_IDGenQuotationFormLabel7"
                    text="Company Name"
                />
                <Input
                    id="_IDGenQuotationFormInput1"
                    value="{oLocalModel>/CompareQuotation/companyName}"
                />
                <Label
                    id="_IDGenQuotationFormLabel8"
                    text="Comparative Statement Title"
                />
                <Input
                    id="_IDGenQuotationFormInput2"
                    value="{oLocalModel>/CompareQuotation/comparativeStatementTitle}"
                />

                <Label
                    id="_IDGenQuotationFormLabel9"
                    text="Requestor Name"
                />
                <Input
                    id="_IDGenQuotationFormInput3"
                    value="{oLocalModel>/CompareQuotation/requestorName}"
                />
                <Label
                    id="_IDGenQuotationFormLabel10"
                    text="Account Assignment"
                />
                <Input
                    id="_IDGenQuotationFormInput4"
                    value="{oLocalModel>/CompareQuotation/accountAssignment}"
                />
                <core:Title id="_IDGenuotationFormTitle2" text="" />
                <Label
                    id="_IDGenQuotationFormLabel11"
                    text="Requisition Number"
                />
                <Input
                    id="_IDGenQuotationFormInput5"
                    value="{oLocalModel>/CompareQuotation/requisitionNumber}"
                />

                <Label
                    id="_IDGenQuotationFormLabel12"
                    text="Requisition Date"
                />
                <DateTimePicker
                    id="_IDGenQuotationFormDateTimePicker"
                    value="{oLocalModel>/CompareQuotation/requisitionDate}"
                />
                <Label
                    id="_IDGenQuotationFormLabel13"
                    text="Purpose"
                />
                <Input
                    id="_IDGenQuotationFormDateTimePicker1"
                    value="{oLocalModel>/CompareQuotation/purpose}"
                />
                <Label
                    id="_IDGenQuotationFormLabel14"
                    text="Comparison Date"
                />
                <DateTimePicker
                    id="_IDGenQuotationFormDateTimePicker2"
                    value="{oLocalModel>/CompareQuotation/comparisonDate}"
                />
            </f:content>
        </f:SimpleForm>

        <VBox id="_IDGenddQCTableSupplierItemsVBox">
        
            <uiTable:TreeTable
                id="_IDGenCompareQuotationSupplierUITable"
                selectionMode="MultiToggle"
                rowSelectionChange=".onCompareQuotationTableRowSelectionChange"
                rows="{path:'oLocalModel>/SupplierQuotation', parameters: {arrayNames:['_SupplierQuotationItem']}}"
                enableSelectAll="false"
                enableCellFilter="true"
                filter=".filterPrice"
                ariaLabelledBy="title"
            >
                <uiTable:extension>
                    <OverflowToolbar
                        id="_IDGenQuotationOverflowToolbar1"
                        style="Clear"
                    >
                        <Title
                            id="_IDGenQuotationComparisonTitle"
                            text="Supplier Quotation and Items"
                        />
                        <ToolbarSpacer id="_IDGenQuotationToolbarSpacer1" />
                        <ToolbarSeparator id="_IDGenQuotationToolbarSeparator" />
                        <SearchField
                            id="_IDGenQuotationSearchField"
                            placeholder="Filter"
                            search=".filterGlobally"
                            width="15rem"
                            visible="false"
                        />
                    </OverflowToolbar>
                </uiTable:extension>
                <uiTable:columns>
                <uiTable:Column
                        id="_IDGenSupplierQuotationColumn"
                        width="11rem"
                        sortProperty="SupplierQuotation"
                        filterProperty="SupplierQuotation"
                    >
                        <Label
                            id="_IDGenSupplierQuotationLabel1"
                            text="Supplier Quotation Number" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenSupplierQuotationText1"
                                text="{oLocalModel>SupplierQuotation}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenRequestForQuotationItemColumn"
                        width="8rem"
                        sortProperty="RequestForQuotationItem"
                        filterProperty="RequestForQuotationItem"
                    >
                        <Label
                            id="_IDGenRequestForQuotationItemLabel1"
                            text="Item No" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenRequestForQuotationItemText1"
                                text="{oLocalModel>RequestForQuotationItem}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenPurchasingDocumentItemTextColumn"
                        width="11rem"
                        sortProperty="PurchasingDocumentItemText"
                        filterProperty="PurchasingDocumentItemText"
                    >
                        <Label
                            id="_IDGenPurchasingDocumentItemTextLabel1"
                            text="Material" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenPurchasingDocumentItemText1"
                                text="{oLocalModel>PurchasingDocumentItemText}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenScheduleLineOrderQuantityColumn"
                        width="6rem"
                        sortProperty="ScheduleLineOrderQuantity"
                        filterProperty="ScheduleLineOrderQuantity"
                    >
                        <Label
                            id="_IDGenScheduleLineOrderQuantityLabel1"
                            text="Quantity" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenScheduleLineOrderQuantityText1"
                                text="{oLocalModel>ScheduleLineOrderQuantity}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenBaseUnitColumn"
                        width="8rem"
                        sortProperty="BaseUnit"
                        filterProperty="BaseUnit"
                    >
                        <Label
                            id="_IDGenBaseUnitLabel2"
                            text="Base Unit of Measure" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenBaseUnitText1"
                                text="{oLocalModel>BaseUnit}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenNetPriceQuantityColumn"
                        width="6rem"
                        sortProperty="NetPriceQuantity"
                        filterProperty="NetPriceQuantity"
                    >
                        <Label
                            id="_IDGenNetPriceQuantityLabel3"
                            text="Unit Price" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenNetPriceQuantityText2"
                                text="{oLocalModel>NetPriceQuantity}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenTotalNetAmountColumn"
                        width="8rem"
                        sortProperty="TotalNetAmount"
                        filterProperty="TotalNetAmount"
                    >
                        <Label
                            id="_IDGenTotalNetAmountLabel3"
                            text="Total value" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenTotalNetAmountText3"
                                text="{oLocalModel>EffectiveAmount}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenScheduleLineDeliveryDateColumn"
                        width="8rem"
                        sortProperty="ScheduleLineDeliveryDate"
                        filterProperty="ScheduleLineDeliveryDate"
                    >
                        <Label
                            id="_IDGenScheduleLineDeliveryDateLabel4"
                            text="Delivery Date"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenScheduleLineDeliveryDateText4"
                                text="{oLocalModel>ScheduleLineDeliveryDate}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenTaxrateColumn"
                        width="6rem"
                        sortProperty="Taxrate"
                        filterProperty="Taxrate"
                    >
                        <Label
                            id="_IDGenTaxrateLabel5"
                            text="Tax Rate" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenTaxrateText5"
                                text="{oLocalModel>Taxrate}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenDiscountColumn"
                        width="6rem"
                        sortProperty="Discount"
                        filterProperty="Discount"
                    >
                        <Label
                            id="_IDGenDiscountLabel5"
                            text="Discount" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenDiscountText5"
                                text="{oLocalModel>CashDiscount1Percent}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenDFreightChargesColumn"
                        width="6rem"
                        sortProperty="FreightCharges"
                        filterProperty="FreightCharges"
                    >
                        <Label
                            id="_IDGenDFreightChargesLabel5"
                            text="Freight Charges" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenDFreightChargesText5"
                                text="{oLocalModel>FreightCharges}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenInsuranceChargesColumn"
                        width="6rem"
                        sortProperty="InsuranceCharges"
                        filterProperty="InsuranceCharges"
                    >
                        <Label
                            id="_IDGenInsuranceChargesLabel5"
                            text="Insurance Charges" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenInsuranceChargesText5"
                                text="{oLocalModel>InsuranceCharges}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenMakeColumn1"
                        width="6rem"
                        sortProperty="Make"
                        filterProperty="Make"
                    >
                        <Label
                            id="_IDGenMakeLabel4"
                            text="Make" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenMakeText4"
                                text="{oLocalModel>Make}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenSpecificationsColumn1"
                        width="6rem"
                        sortProperty="Specifications"
                        filterProperty="Specifications"
                    >
                        <Label
                            id="_IDGenSpecificationsLabel4"
                            text="Specifications" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenSpecificationsText4"
                                text="{oLocalModel>Specifications}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                </uiTable:columns>
            </uiTable:TreeTable>
        </VBox>
        <buttons>
            <Button
                id="_IDGendCompareQuotationButton"
                text="Add"
                press=".onAddCompareQuotationCreatePress"
            />
            <Button
                id="_IDGendCompareQuotationCancelButton"
                text="Cancel"
                press=".onAddCompareQuotationCancelPress"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
