<core:FragmentDefinition
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:uiTable="sap.ui.table"
    xmlns:macros="sap.fe.macros"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="mySelectDialog"
        title="Create Quotation"
    >
        <!-- <macros:Form
            metaPath="/RFQs/QuotationComparison/@com.sap.vocabularies.UI.v1.FieldGroup#QuotationComparisonDetails"
            id="_IDGenddQuotationCreateForm"
            title="Sample Form"
        /> -->
        <f:SimpleForm
            id="SimpleFormChange480_Trial"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4"
            labelSpanL="4"
            labelSpanM="4"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="0"
            emptySpanL="0"
            emptySpanM="0"
            emptySpanS="0"
            columnsXL="3"
            columnsL="2"
            columnsM="2"
            singleContainerFullSize="false"
        >
            <f:content>
                <core:Title id="_IDGenuotationFormTitle1" text="" />
                <Label
                    id="_IDGenQuotationFormLabel6"
                    text="RFQ"
                />
                <Input
                    id="_IDGenQuotationFormInput"
                    value="{oLocalModel>/CompareQuotation/rfq}"
                    editable="false"
                />
                <Label
                    id="_IDGenQuotationFormLabel7"
                    text="Company Name"
                />
                <Input
                    id="_IDGenQuotationFormInput1"
                    value="{oLocalModel>/CompareQuotation/companyName}"
                />
                <Label
                    id="_IDGenQuotationFormLabel8"
                    text="Comparative Statement Title"
                />
                <Input
                    id="_IDGenQuotationFormInput2"
                    value="{oLocalModel>/CompareQuotation/comparativeStatementTitle}"
                />

                <Label
                    id="_IDGenQuotationFormLabel9"
                    text="Requestor Name"
                />
                <Input
                    id="_IDGenQuotationFormInput3"
                    value="{oLocalModel>/CompareQuotation/requestorName}"
                />
                <Label
                    id="_IDGenQuotationFormLabel10"
                    text="Account Assignment"
                />
                <Input
                    id="_IDGenQuotationFormInput4"
                    value="{oLocalModel>/CompareQuotation/accountAssignment}"
                />
                <core:Title id="_IDGenuotationFormTitle2" text="" />
                <Label
                    id="_IDGenQuotationFormLabel11"
                    text="Requisition Number"
                />
                <Input
                    id="_IDGenQuotationFormInput5"
                    value="{oLocalModel>/CompareQuotation/requisitionNumber}"
                />

                <Label
                    id="_IDGenQuotationFormLabel12"
                    text="Requisition Date"
                />
                <DateTimePicker
                    id="_IDGenQuotationFormDateTimePicker"
                    value="{oLocalModel>/CompareQuotation/requisitionDate}"
                />
                <Label
                    id="_IDGenQuotationFormLabel13"
                    text="Purpose"
                />
                <Input
                    id="_IDGenQuotationFormDateTimePicker1"
                    value="{oLocalModel>/CompareQuotation/purpose}"
                />
                <Label
                    id="_IDGenQuotationFormLabel14"
                    text="Comparison Date"
                />
                <DateTimePicker
                    id="_IDGenQuotationFormDateTimePicker2"
                    value="{oLocalModel>/CompareQuotation/comparisonDate}"
                />
            </f:content>
        </f:SimpleForm>

        <VBox id="_IDGenddQCTableSupplierItemsVBox">
        
            <uiTable:TreeTable
                id="_IDGenCompareQuotationSupplierUITable"
                selectionMode="MultiToggle"
                rowSelectionChange=".onCompareQuotationTableRowSelectionChange"
                rows="{path:'oLocalModel>/SupplierQuotation', parameters: {arrayNames:['_SupplierQuotationItem']}}"
                enableSelectAll="false"
                enableCellFilter="true"
                filter=".filterPrice"
                ariaLabelledBy="title"
            >
                <uiTable:extension>
                    <OverflowToolbar
                        id="_IDGenQuotationOverflowToolbar1"
                        style="Clear"
                    >
                        <Title
                            id="_IDGenQuotationComparisonTitle"
                            text="Supplier Quotation and Items"
                        />
                        <ToolbarSpacer id="_IDGenQuotationToolbarSpacer1" />
                        <ToolbarSeparator id="_IDGenQuotationToolbarSeparator" />
                        <SearchField
                            id="_IDGenQuotationSearchField"
                            placeholder="Filter"
                            search=".filterGlobally"
                            width="15rem"
                            visible="false"
                        />
                    </OverflowToolbar>
                </uiTable:extension>
                <uiTable:columns>
                    <uiTable:Column
                        id="_IDGenSupplierColumn"
                        width="10rem"
                        sortProperty="Supplier"
                        filterProperty="Supplier"
                    >
                        <Label
                            id="_IDGenSupplierLabel1"
                            text="Supplier" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenSupplierText1"
                                text="{oLocalModel>Supplier}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenSupplierQuotationColumn"
                        width="6rem"
                        sortProperty="SupplierQuotation"
                        filterProperty="SupplierQuotation"
                    >
                        <Label
                            id="_IDGenSupplierQuotationLabel1"
                            text="Supplier Quotation No" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenSupplierQuotationText1"
                                text="{oLocalModel>SupplierQuotation}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenSupplierQuotationItemColumn"
                        width="6rem"
                        sortProperty="SupplierQuotationItem"
                        filterProperty="SupplierQuotationItem"
                    >
                        <Label
                            id="_IDGenSupplierQuotationItemLabel1"
                            text="Supplier Quotation Item" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenSupplierQuotationItemText1"
                                text="{oLocalModel>SupplierQuotationItem}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenMaterialColumn"
                        width="8rem"
                        sortProperty="Material"
                        filterProperty="Material"
                    >
                        <Label
                            id="_IDGenLabel2"
                            text="Material" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenText1"
                                text="{oLocalModel>Material}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenMaterialGroupColumn"
                        width="6rem"
                        sortProperty="MaterialGroup"
                        filterProperty="MaterialGroup"
                    >
                        <Label
                            id="_IDGenLabel3"
                            text="Material Group" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenText2"
                                text="{oLocalModel>MaterialGroup}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenPurchaseRequisitionColumn"
                        width="8rem"
                        sortProperty="PurchaseRequisition"
                        filterProperty="PurchaseRequisition"
                    >
                        <Label
                            id="_IDGenPurchaseRequisitionLabel3"
                            text="Purchase Requisition / Item" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenPurchaseRequisitionText3"
                                text="{= ${oLocalModel>PurchaseRequisition} ? ${oLocalModel>PurchaseRequisition} + ' - ' + ${oLocalModel>PurchaseRequisitionItem} : '' }"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenPurchaseRequisitionItemColumn"
                        width="8rem"
                        sortProperty="PurchasingDocumentItemText"
                        filterProperty="PurchasingDocumentItemText"
                    >
                        <Label
                            id="_IDGenPurchaseRequisitionItemLabel4"
                            text="Make"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenPurchaseRequisitionItemText4"
                                text="{oLocalModel>PurchasingDocumentItemText}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenScheduleLineOrderQuantityColumn"
                        width="6rem"
                        sortProperty="ScheduleLineOrderQuantity"
                        filterProperty="ScheduleLineOrderQuantity"
                    >
                        <Label
                            id="_IDGenScheduleLineOrderQuantityLabel5"
                            text="Quantity" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenScheduleLineOrderQuantityText4"
                                text="{oLocalModel>ScheduleLineOrderQuantity} {oLocalModel>BaseUnit}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenNetPriceAmountColumn1"
                        width="6rem"
                        sortProperty="NetPriceAmount"
                        filterProperty="NetPriceAmount"
                    >
                        <Label
                            id="_IDGenNetPriceAmountLabel4"
                            text="Net Price Amount" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenNetPriceAmountText4"
                                text="{= ${oLocalModel>NetPriceAmount} ? ${oLocalModel>NetPriceAmount} + ' ' + ${oLocalModel>DocumentCurrency} : '' }"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column
                        id="_IDGenNetAmountColumn1"
                        width="6rem"
                        sortProperty="NetAmount"
                        filterProperty="NetAmount"
                    >
                        <Label
                            id="_IDGenNetAmountLabel4"
                            text="Total Amount" wrapping="true"
                        />
                        <uiTable:template>
                            <Text
                                id="_IDGenNetAmountText4"
                                text="{= ${oLocalModel>NetAmount} ? ${oLocalModel>NetAmount} + ' ' + ${oLocalModel>DocumentCurrency} : '' }"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                </uiTable:columns>
            </uiTable:TreeTable>
        </VBox>
        <buttons>
            <Button
                id="_IDGendCompareQuotationButton"
                text="Create"
                press=".onAddCompareQuotationCreatePress"
            />
            <Button
                id="_IDGendCompareQuotationCancelButton"
                text="Cancel"
                press=".onAddCompareQuotationCancelPress"
            />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
