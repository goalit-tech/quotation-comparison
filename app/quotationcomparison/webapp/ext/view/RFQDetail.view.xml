<mvc:View
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:macros="sap.fe.macros"
    xmlns:filterBar="sap.fe.macros.filterBar"
    xmlns:table="sap.fe.macros.table"
    xmlns:html="http://www.w3.org/1999/xhtml"
    controllerName="nlabs.ui.quotationcomparison.ext.view.RFQDetail"
>
    <macros:Page
        id="RFQDetail"
        showFooter="true"
        title="{RequestForQuotation}"
        description="{CompanyCode}"
    >
        <!-- Main content -->
        <macros:items>
            <IconTabBar
                expanded="true"
                id="stickySubheaderBar"
                select=".onIconTabBarSelect"
                class="sapUiResponsiveContentPadding"
            >
                <items>
                    <IconTabFilter
                        id="_IDGenIconTabFilter1"
                        text="RFQ Details"
                    >
                        <macros:Form
                            metaPath="/RFQs/@com.sap.vocabularies.UI.v1.FieldGroup#GeneralInformation"
                            id="_IDGenRFQFormGeneralInformation"
                        />
                        <macros:Table
                            id="_IDGenTableRFQItems"
                            metaPath="/RFQs/to_RequestForQuotationItem/@com.sap.vocabularies.UI.v1.LineItem"
                        />
                        
                    </IconTabFilter>
                    <IconTabFilter
                        id="_IDGenIconTabFilter2"
                        text="Supplier Quotation"
                    >
                        <macros:Table
                            id="_IDGenTableSupplierQuotation"
                            metaPath="/RFQs/SupplierQuotation/@com.sap.vocabularies.UI.v1.LineItem"
                        />
                    </IconTabFilter>
                    <IconTabFilter
                        id="_IDGenIconTabFilter3"
                        text="Quotation Comparisons"
                    >
                        <macros:Table
                            id="_IDGenTableQuotationComparisons"
                            metaPath="/RFQs/QuotationComparison/@com.sap.vocabularies.UI.v1.LineItem"
                            selectionMode="ForceSingle"
                            selectionChange=".onQuotationComparisonSelectionChange"
                            readOnly="false"
                        >
                            <macros:actions>
                                <table:Action
                                    id="_IDGenQuotationComparisonActionGroup1"
                                    key="CreateACtionQuotation"
                                    text="Add Quotation"
                                    press=".onAddQuotationPress"
                                    visible="{= !${oLocalModel>/compareQuotationIsEditable} }"
                                />
                                <table:Action
                                    id="_IDGenQuotationComparisonActionGroup2"
                                    key="EditACtionCompareQuotation"
                                    text="Edit"
                                    press=".onCompareQuotationEditPress"
                                    requiresSelection="true"
                                    visible="{= !${oLocalModel>/compareQuotationIsEditable} }"
                                />
                                <table:Action
                                    id="_IDGenQuotationComparisonActionGroup3"
                                    key="DeleteACtionCompareQuotation"
                                    text="Delete"
                                    press=".onCompareQuotationDeletePress"
                                    requiresSelection="true"
                                    visible="{= !${oLocalModel>/compareQuotationIsEditable} }"
                                />
                            </macros:actions>
                        </macros:Table>
                         <core:Fragment id="_IDGenQuotationComparisonDetailFragment" fragmentName="nlabs.ui.quotationcomparison.ext.fragments.QuotationComparisonDetail" type="XML" />
                    
                    </IconTabFilter>
                    <IconTabFilter
                        id="_IDGenIconTabFilterTermsandConditions"
                        text="Terms and Conditions"
                    >
                       <core:Fragment id="_IDGenTermsAndConditionsFragment" fragmentName="nlabs.ui.quotationcomparison.ext.fragments.TermsAndCondition" type="XML" />
                      
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </macros:items>

        <!-- Footer aggregation -->
        <macros:footer>
            <OverflowToolbar id="_IDGenOverflowToolbar">
                <ToolbarSpacer id="_IDGenToolbarSpacer" />
                <Button
                    id="_IDGenButton"
                    text="Approve"
                    press=".onApprove"
                    type="Accept"
                    icon=""
                />
                <Button
                    id="_IDGenButton1"
                    text="Reject"
                    press=".onReject"
                    type="Reject"
                    icon=""
                />
            </OverflowToolbar>
        </macros:footer>
    </macros:Page>
</mvc:View>
