<mvc:View
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:macros="sap.fe.macros"
    xmlns:filterBar="sap.fe.macros.filterBar"
    xmlns:html="http://www.w3.org/1999/xhtml"
    controllerName="nlabs.ui.quotationcomparison.ext.view.Main"
>
    <macros:Page
        id="Page"
        title="Quotation Comparison"
    >
        <VBox id="_IDGenVBox1">
            <macros:FilterBar
                metaPath="/RFQs/@com.sap.vocabularies.UI.v1.SelectionFields"
                id="FilterBar"
                showMessages="true"
            />
            <macros:Table
                metaPath="@com.sap.vocabularies.UI.v1.LineItem"
                id="LineItemTable"
                filterBar="FilterBar"
                enableAutoColumnWidth="true"
                initialLoad="true"

            />
        </VBox>
    </macros:Page>
</mvc:View>
