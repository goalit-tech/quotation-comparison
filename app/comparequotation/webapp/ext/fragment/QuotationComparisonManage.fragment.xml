                    <uiTable:Column id="_IDGenQCManageFragmentColumn11"
                        
                        width="6rem"
                        sortProperty="YY1_MaterialMake_PDI"
                        filterProperty="YY1_MaterialMake_PDI"
                    >
                        <Label id="_IDGenQCManageFragmentLabel20"
                            
                            text="Make" wrapping="true"
                        />
                        <uiTable:template>
                            <Text id="_IDGenQCManageFragmentText11"
                                
