                        <uiTable:template>
                            <Text id="_IDGenQCManageFragmentText7"
                                
                                text="{LocalModel>BaseUnit}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column id="_IDGenQCManageFragmentColumn8"
                        
                        width="8rem"
                        sortProperty="NetPriceAmount"
                        filterProperty="NetPriceAmount"
                    >
                        <Label id="_IDGenQCManageFragmentLabel17"
                            
                            text="Total value" wrapping="true"
                        />
                        <uiTable:template>
                            <Text id="_IDGenQCManageFragmentText8"
                                
                                text="{LocalModel>NetPriceAmount}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column id="_IDGenQCManageFragmentColumn9"
                        
                        width="8rem"
                        sortProperty="NetAmount"
                        filterProperty="NetAmount"
                    >
                        <Label id="_IDGenQCManageFragmentLabel18"
                            
                            text="Total value" wrapping="true"
                        />
                        <uiTable:template>
                            <Text id="_IDGenQCManageFragmentText9"
                                
                                text="{LocalModel>NetAmount}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column id="_IDGenQCManageFragmentColumn10"
                        
                        width="8rem"
                        sortProperty="ScheduleLineDeliveryDate"
                        filterProperty="ScheduleLineDeliveryDate"
                    >
                        <Label id="_IDGenQCManageFragmentLabel19"
                            
                            text="Delivery Date"
                        />
                        <uiTable:template>
                            <Text id="_IDGenQCManageFragmentText10"
                                
                                text="{LocalModel>ScheduleLineDeliveryDate}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
