<core:FragmentDefinition
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:uiTable="sap.ui.table"
    xmlns:macros="sap.fe.macros"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:core="sap.ui.core"
>
        <f:SimpleForm id="_IDGenQCManageFragmentSimpleForm1"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="4"
            labelSpanL="4"
            labelSpanM="4"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="0"
            emptySpanL="0"
            emptySpanM="0"
            emptySpanS="0"
            columnsXL="3"
            columnsL="2"
            columnsM="2"
            singleContainerFullSize="false"
        >
            <f:content>
                <core:Title id="_IDGenQCManageFragmentTitle"  text="" />
                <Label id="_IDGenQCManageFragmentLabel"
                    
                    text="Request For Quotation"
                />
                <Input id="_IDGenQCManageFragmentInput"
                    
                    value="{LocalModel>/CompareQuotation/RequestForQuotation}"
                    editable="false"
                />
                <Label id="_IDGenQCManageFragmentLabel1"
                    
                    text="Company Code"
                />
                <Input id="_IDGenQCManageFragmentInput1"
                    
                    value="{LocalModel>/CompareQuotation/CompanyName} ({LocalModel>/CompareQuotation/CompanyCode})"
                    editable="false"
                />
                    <!-- value="{LocalModel>/CompareQuotation/CompanyCode}" -->
                    <!-- value="{LocalModel>/CompareQuotation/CompanyName} ({LocalModel>/CompareQuotation/CompanyCode})" -->
                <Label id="_IDGenQCManageFragmentLabel2"
                    
                    text="Comparative Statement Title"
                />
                <Input id="_IDGenQCManageFragmentInput2"
                    
                    value="{LocalModel>/CompareQuotation/CompativeStatementTitle}"
                />

                <Label id="_IDGenQCManageFragmentLabel3"
                    
                    text="Requestor Name"
                />
                <Input id="_IDGenQCManageFragmentInput3"
                    
                    value="{LocalModel>/CompareQuotation/NameOfRequester}"
                />
                <Label id="_IDGenQCManageFragmentLabel4"
                    
                    text="Account Assignment"
                />
                <Input id="_IDGenQCManageFragmentInput4"
                    
                    value="{LocalModel>/CompareQuotation/AccountAssignment}"
                />
                <core:Title id="_IDGenQCManageFragmentTitle1"  text="" />
                <Label id="_IDGenQCManageFragmentLabel5"
                    
                    text="Requisition Number"
                />
                <Input id="_IDGenQCManageFragmentInput5"
                    
                    value="{LocalModel>/CompareQuotation/RequisitionNumber}"
                />

                <Label id="_IDGenQCManageFragmentLabel6"
                    
                    text="Requisition Date"
                />
                <!-- value="{LocalModel>/CompareQuotation/RequisitionDate}" -->
                <DatePicker id="_IDGenQCManageFragmentDatePicker"
                    
                    	value="{
						'path':'LocalModel>/CompareQuotation/RequisitionDate',
						'type':'sap.ui.model.type.Date',
						'formatOptions': {
							'pattern': 'yyyy-MM-dd'
						}
					}"
                />
                <Label id="_IDGenQCManageFragmentLabel7"
                    
                    text="Purpose"
                />
                <Input id="_IDGenQCManageFragmentInput6"
                    
                    value="{LocalModel>/CompareQuotation/Purpose}"
                />
                <Label id="_IDGenQCManageFragmentLabel8"
                    
                    text="Comparison Date"
                />
                <!-- value="{LocalModel>/CompareQuotation/ComparisonDate}" -->
                <DatePicker id="_IDGenQCManageFragmentDatePicker1"
                    
                    value="{
						'path':'LocalModel>/CompareQuotation/ComparisonDate',
						'type':'sap.ui.model.type.Date',
						'formatOptions': {
							'pattern': 'yyyy-MM-dd'
						}
					}"
                />
            </f:content>
        </f:SimpleForm>

        <!-- <VBox id="_IDGenQCManageFragmentVBox" > -->
        
                <!-- rowSelectionChange=".onCompareQuotationTableRowSelectionChange" -->
                <!-- rows="{path:'LocalModel>/SupplierQuotation', parameters: {arrayNames:['_SupplierQuotationItem']}}" -->
            <uiTable:Table id="_IDGenQCManageFragmentTable"
                
                selectionMode="MultiToggle"
                enableSelectAll="false"
                rows="{LocalModel>/SupplierQuotationItem}"
                enableCellFilter="true"
                filter=".filterPrice"
                ariaLabelledBy="title"
            >
                <uiTable:extension>
                    <OverflowToolbar id="_IDGenQCManageFragmentOverflowToolbar"
                        
                        style="Clear"
                    >
                        <Title id="_IDGenQCManageFragmentTitle2"
                            
                            text="Supplier Quotation and Items"
                        />
                        <ToolbarSpacer id="_IDGenQCManageFragmentToolbarSpacer"  />
                        <ToolbarSeparator id="_IDGenQCManageFragmentToolbarSeparator"  />
                        <SearchField id="_IDGenQCManageFragmentSearchField"
                            
                            placeholder="Filter"
                            search=".filterGlobally"
                            width="15rem"
                            visible="false"
                        />
                    </OverflowToolbar>
                </uiTable:extension>
                <uiTable:columns>
                <uiTable:Column id="_IDGenQCManageFragmentColumn"
                        
                        width="9rem"
                        sortProperty="SupplierQuotation"
                        filterProperty="SupplierQuotation"
                    >
                        <Label id="_IDGenQCManageFragmentLabel9"
                            
                            text="Supplier Quotation" wrapping="true"
                        />
                        <uiTable:template>
                            <Text id="_IDGenQCManageFragmentText"
                                
                                text="{LocalModel>SupplierQuotation}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                <uiTable:Column id="_IDGenQCManageFragmentColumn1"
                        
                        width="11rem"
                        sortProperty="SupplierName"
                        filterProperty="SupplierName"
                    >
                        <Label id="_IDGenQCManageFragmentLabel10"
                            
                            text="Supplier Name" wrapping="true"
                        />
                        <uiTable:template>
                            <Text id="_IDGenQCManageFragmentText1"
                                
                                text="{LocalModel>SupplierName}"
                                wrapping="true"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                <uiTable:Column id="_IDGenQCManageFragmentColumn2"
                        
                        width="9rem"
                        sortProperty="SupplierCode"
                        filterProperty="SupplierCode"
                    >
                        <Label id="_IDGenQCManageFragmentLabel11"
                            
                            text="Supplier Code" wrapping="true"
                        />
                        <uiTable:template>
                            <Text id="_IDGenQCManageFragmentText2"
                                
                                text="{LocalModel>SupplierCode}"
                                wrapping="true"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column id="_IDGenQCManageFragmentColumn3"
                        
                        width="6rem"
                        sortProperty="RequestForQuotationItem"
                        filterProperty="RequestForQuotationItem"
                    >
                        <Label id="_IDGenQCManageFragmentLabel12"
                            
                            text="Item No" wrapping="true"
                        />
                        <uiTable:template>
                            <Text id="_IDGenQCManageFragmentText3"
                                
                                text="{LocalModel>RequestForQuotationItem}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column id="_IDGenQCManageFragmentColumn4"
                        
                        width="11rem"
                        sortProperty="PurchasingDocumentItemText"
                        filterProperty="PurchasingDocumentItemText"
                    >
                        <Label id="_IDGenQCManageFragmentLabel13"
                            
                            text="Material Description" wrapping="true"
                        />
                        <uiTable:template>
                            <Text id="_IDGenQCManageFragmentText4"
                                
                                text="{LocalModel>PurchasingDocumentItemText}" wrapping="true"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column id="_IDGenQCManageFragmentColumn5"
                        
                        width="8rem"
                        sortProperty="Material"
                        filterProperty="Material"
                    >
                        <Label id="_IDGenQCManageFragmentLabel14"
                            
                            text="Material" wrapping="true"
                        />
                        <uiTable:template>
                            <Text id="_IDGenQCManageFragmentText5"
                                
                                text="{LocalModel>Material}" wrapping="true"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column id="_IDGenQCManageFragmentColumn6"
                        
                        width="6rem"
                        sortProperty="ScheduleLineOrderQuantity"
                        filterProperty="ScheduleLineOrderQuantity"
                    >
                        <Label id="_IDGenQCManageFragmentLabel15"
                            
                            text="Quantity" wrapping="true"
                        />
                        <uiTable:template>
                            <Text id="_IDGenQCManageFragmentText6"
                                
                                text="{LocalModel>ScheduleLineOrderQuantity}"
                            />
                        </uiTable:template>
                    </uiTable:Column>
                    <uiTable:Column id="_IDGenQCManageFragmentColumn7"
                        
                        width="8rem"
                        sortProperty="BaseUnit"
                        filterProperty="BaseUnit"
