<core:FragmentDefinition
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:macros="sap.fe.macros"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:core="sap.ui.core"
>
    <Dialog id="_IDGenCQRFQDialogDialog1"
        title="Select Request For Quotation"
    >
    <!-- <macros:FilterBar id="_IDGenCQuotationLRFilterBar"
                metaPath="/A_RequestForQuotation/@com.sap.vocabularies.UI.v1.SelectionFields"
                showMessages="true"
            /> -->
            <!-- filterBar="_IDGenCQuotationLRFilterBar" -->
            <!-- isSearchable="false" -->
       <macros:Table id="_IDGenCQRFQDialogTable"
            metaPath="/A_RequestForQuotation/@com.sap.vocabularies.UI.v1.LineItem"
            selectionMode="ForceSingle"
            initialLoad="true"
            selectionChange=".onRFQDialogTableRowSelectionChange"

        />
      
        <buttons>
            <Button id="_IDGenCQRFQDialogButton"
                text="Confirm"
