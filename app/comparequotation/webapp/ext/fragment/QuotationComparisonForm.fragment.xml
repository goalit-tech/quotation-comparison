<core:FragmentDefinition
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:uiTable="sap.ui.table"
    xmlns:macros="sap.fe.macros"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:core="sap.ui.core">
    <OverflowToolbar
                id="_IDGenQCFormFragmentOverflowToolbar"
                style="Clear"
            >
            <ToolbarSpacer id="_IDGenQCFormFragmentToolbarSpacer" />
                <Title
                    id="_IDGenQCFormFragmentTitle2"
                    text="EENADU TELEVISION PRIVATE LIMITED"
                />
                <ToolbarSeparator id="_IDGenQCFormFragmentToolbarSeparator" />
            </OverflowToolbar>
    <f:SimpleForm
            id="_IDGenQCFormFragmentSimpleForm"
            editable="true"
            title="{LocalModel>/CompareQuotationHeader/CompativeStatementTitle}"
            layout="ResponsiveGridLayout"
            labelSpanXL="4"
            labelSpanL="4"
            labelSpanM="4"
            labelSpanS="12"
            adjustLabelSpan="false"
            emptySpanXL="0"
            emptySpanL="0"
            emptySpanM="0"
            emptySpanS="0"
            columnsXL="3"
            columnsL="2"
            columnsM="2"
            singleContainerFullSize="false"
        >
            <f:content>
                <core:Title id="_IDGenQCFormFragmentFormTitle1" text="" />
                <Label
                    id="_IDGenQCFormFragmentFormLabel"
                    text="Request For Quotation"
                />
                <Input
                    id="_IDGenQCFormFragmentFormInput"
                    value="{LocalModel>/CompareQuotationHeader/RequestForQuotation}"
                    editable="false"
                />
                <Label
                    id="_IDGenQCFormFragmentFormLabel3"
                    text="Company Code"
                />
                <Input
                    id="_IDGenQCFormFragmentFormInput3"
                    value="{LocalModel>/CompareQuotationHeader/CompanyCode}"
                    editable="false"
                />
                <Label
                    id="_IDGenQCFormFragmentCompativeFormLabel"
                    text="Comparative Statement Title"
                />
                <Input
                    id="_IDGenQCFormFragmentCompativeFormInput"
                    value="{LocalModel>/CompareQuotationHeader/CompativeStatementTitle}"
                    editable="{oLocalModel>/compareQuotationIsEditable}"
                />

                <Label
                    id="_IDGenQCFormFragmentNameOfRequesterFormLabel"
                    text="Requestor Name"
                />
                <Input
                    id="_IDGenQCFormFragmentNameOfRequesterFormInput"
                    value="{LocalModel>/CompareQuotationHeader/NameOfRequester}"
                    editable="false"
                />
                <Label
                    id="_IDGenQCFormFragmentAccountAssignmentFormLabel"
                    text="Account Assignment"
                />
                <Input
                    id="_IDGenQCFormFragmentAccountAssignmentFormInput"
                    value="{LocalModel>/CompareQuotationHeader/AccountAssignment}"
                    editable="false"
                />
                <core:Title id="_IDGenQCFormFragmentFormTitle2" text="" />
                <Label
                    id="_IDGenQCFormFragmentRequisitionNumberFormLabel"
                    text="Requisition Number"
                />
                <Input
                    id="_IDGenQCFormFragmentRequisitionNumberFormInput"
                    value="{LocalModel>/CompareQuotationHeader/RequisitionNumber}"
                    editable="{oLocalModel>/compareQuotationIsEditable}"
                />

                <Label
                    id="_IDGenQCFormFragmentRequisitionDateFormLabel"
                    text="Requisition Date"
                />
                <!-- value="{LocalModel>/CompareQuotationHeader/RequisitionDate}" -->
                <DatePicker
                    id="_IDGenQCFormFragmentRequisitionDateFormDateTimePicker"
                    editable="{oLocalModel>/compareQuotationIsEditable}"
                    	value="{
						path: 'LocalModel>/CompareQuotationHeader/RequisitionDate',
                            type: 'sap.ui.model.type.Date',
                            formatOptions: {
                                source: {
                                    pattern: 'yyyy-MM-dd'
                                },
                                pattern: 'yyyy-MM-dd'
                            }
					}"
                />
                <Label
                    id="_IDGenQCFormFragmentPurposeFormLabel"
                    text="Purpose"
                />
                <Input
                    id="_IDGenQCFormFragmentPurposeFormInput"
                    value="{LocalModel>/CompareQuotationHeader/Purpose}"
                    editable="{oLocalModel>/compareQuotationIsEditable}"
                />
                <Label
                    id="_IDGenQCFormFragmentComparisonDateFormLabel"
                    text="Comparison Date"
                />
                <!-- value="{LocalModel>/CompareQuotationHeader/ComparisonDate}" -->
                <DatePicker
                    id="_IDGenQCFormFragmentComparisonDateFormDateTimePicker"
                    value="{
						path: 'LocalModel>/CompareQuotationHeader/ComparisonDate',
                            type: 'sap.ui.model.type.Date',
                            formatOptions: {
                                source: {
                                    pattern: 'yyyy-MM-dd'
                                },
                                pattern: 'yyyy-MM-dd'
                            }
					}"
                    editable="{oLocalModel>/compareQuotationIsEditable}"
                />
                
            </f:content>
        </f:SimpleForm>
        <VBox id="_IDGenQCFormFragmentVBox">
                <!-- rows="{oLocalModel>/compareQuotationItemData}" -->
            <uiTable:Table
                id="_IDGenQCFormFragmentUITable"
                enableCellFilter="true"
                showNoData="true"
                selectionMode="None"
                rows="{
                    path: 'oLocalModel>/compareQuotationItemData',
                    sorter: {
                        path: 'Description',
                        descending: false
                    }
                }"
            >
               </uiTable:Table>
        </VBox>
</core:FragmentDefinition>
