{
  "_version": "1.84.0",
  "sap.app": {
    "id": "nlabs.ai.cq.comparequotation",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:fpm",
      "version": "1.24.0",
      "toolsId": "3d3d8f7a-d8e6-417a-b43d-5e6f854173a9"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/compare-quotation/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.01"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "nlabs.ai.cq.comparequotation.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "LocalModel": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/localModel.json",
        "preload": true
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "name": "QuotationComparisonMain",
          "pattern": ":?query:",
          "target": "QuotationComparisonMain"
        },
        {
          "pattern": "ManageQuotationComparison:?query:",
          "name": "ManageQuotationComparisonPage",
          "target": "ManageQuotationComparisonPage"
        },
        {
          "pattern": "QuotationComparison({key}):?query:",
          "name": "QuotationComparisonObjectPage",
          "target": "QuotationComparisonObjectPage"
        }
      ],
      "targets": {
        "QuotationComparisonMain": {
          "type": "Component",
          "id": "QuotationComparisonMain",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "CreateComparison": {
                      "text": "Create",
                      "press": "nlabs.ai.cq.comparequotation.ext.view.LRCompareQuotation.onCreateLRActionPress"
                    },
                    "UpdateComparison": {
                      "text": "Update",
                      "press": "nlabs.ai.cq.comparequotation.ext.view.Main.onUpdateLRActionPress",
                      "requiresSelection": true
                    },
                    "DeleteComparison": {
                      "text": "Delete",
                      "press": "nlabs.ai.cq.comparequotation.ext.view.Main.onDeleteLRActionPress",
                      "requiresSelection": true
                    }
                  }
                }
              },
              "navigation": {
                "QuotationComparison": {
                  "detail": {
                    "route": "QuotationComparisonObjectPage"
                  }
                }
              },
              "contextPath": "/QuotationComparison",
              "viewName": "nlabs.ai.cq.comparequotation.ext.view.Main"
            }
          }
        },
        "QuotationComparisonObjectPage": {
          "type": "Component",
          "id": "CompareQuotationDetailObjectPage",
          "name": "sap.fe.core.fpm",
          "title": "Quotation Comparison Detail",
          "options": {
            "settings": {
              "viewName": "nlabs.ai.cq.comparequotation.ext.view.ManageCompareQuotation",
              "contextPath": "/QuotationComparison"
            }
          }
        },
        "ManageQuotationComparisonPage": {
          "type": "Component",
          "id": "ManageQuotationComparisonPage",
          "name": "sap.fe.core.fpm",
          "title": "Quotation Comparison Detail",
          "options": {
            "settings": {
              "viewName": "nlabs.ai.cq.comparequotation.ext.view.ManageCompareQuotation",
              "contextPath": "/QuotationComparison"
            }
          }
        }
      }
    }
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}