{
  "name": "quotationcomparison",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4.6.0",
    "@sap-cloud-sdk/http-client": "^4.6.0",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^9.9.1",
    "@sap/xsenv": "^6.2.0",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch-quotationui": "cds watch --open com.nlabs.qc.quotationui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-quotationcomparison": "cds watch --open nlabs.ui.quotationcomparison/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy quotationcomparison --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-quotationcompare": "cds watch --open com.nlab.ui.quotationcompare/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "S4_API_RFQ_PROCESS": {
        "kind": "odata-v2",
        "model": "srv/external/API_RFQ_PROCESS_SRV",
        "credentials": {
          "destination": "S4_API",
          "path": "sap/opu/odata/sap/API_RFQ_PROCESS_SRV/"
        },
        "[production]": {
          "credentials": {
            "destination": "S4_API",
            "path": "sap/opu/odata/sap/API_RFQ_PROCESS_SRV/"
          }
        },
        "csrf": true,
        "csrfInBatch": true
      },
      "S4_API_SUPPLIER_QUOTATION": {
        "kind": "odata-v4",
        "model": "srv/external/API_SUPPLIER_QUOTATION_SRV",
        "credentials": {
          "destination": "S4_API",
          "path": "sap/opu/odata4/sap/api_supplierquotation_2/srvd_a2x/sap/supplierquotation/0001/"
        },
        "[production]": {
          "credentials": {
            "destination": "S4_API",
            "path": "sap/opu/odata4/sap/api_supplierquotation_2/srvd_a2x/sap/supplierquotation/0001/"
          }
        },
        "csrf": true,
        "csrfInBatch": true
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/quotationui",
    "app/quotationcomparison",
    "app/quotationcompare",
    "app/quotationcomparison"
  ]
}
